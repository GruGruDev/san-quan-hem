# Copy file này thành ".env" (cùng thư mục server/) rồi điền giá trị thật.
# KHÔNG commit file .env lên Git. Trên Render: khai báo trong Environment.

MONGO_URI=mongodb+srv://<user>:<password_moi>@<cluster>.mongodb.net/san_quan_hem?retryWrites=true&w=majority
JWT_SECRET=<chuoi_ngau_nhien_dai_it_nhat_32_ky_tu>
PORT=3001
# Username tài khoản quản trị, đúng với username trong MongoDB; nhiều tài khoản cách nhau bằng dấu phẩy.
# Đăng nhập bằng tài khoản/mật khẩu hiện có tại đường dẫn /admin.
ADMIN_USERNAMES=<ten_dang_nhap_admin_phan_tach_bang_dau_phay>
# VietQR / nạp Hẻm Coin
PAYMENT_BANK_CODE=timo
PAYMENT_ACCOUNT_NUMBER=9021299047706
PAYMENT_ACCOUNT_NAME=NGUYEN TRI TAI
# Đặt API Key trong cấu hình webhook SePay và cùng giá trị này trên server.
SEPAY_WEBHOOK_API_KEY=<api_key_webhook_sepay>
CLIENT_ORIGINS=https://san-quan-hem.vercel.app,http://localhost:5173,http://localhost:3000
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<tai_khoan_smtp>
SMTP_PASS=<mat_khau_ung_dung_smtp>
SMTP_FROM=<email_gui_ma_otp>
# Tùy chọn ưu tiên gửi qua HTTPS (Resend); sender cần thuộc domain đã xác minh.
RESEND_API_KEY=<api_key_resend>
RESEND_FROM=<Săn Quán Hẻm <no-reply@ten-mien-da-xac-minh.com>>

# OAuth đăng nhập Google / Facebook (tùy chọn)
# Đăng ký đúng callback URL dưới đây trong Google Cloud Console và Meta Login:
# https://san-quan-hem-backend.onrender.com/api/auth/google/callback
# https://san-quan-hem-backend.onrender.com/api/auth/facebook/callback
PUBLIC_SERVER_URL=https://san-quan-hem-backend.onrender.com
CLIENT_URL=https://san-quan-hem.vercel.app
GOOGLE_CLIENT_ID=<google_oauth_client_id>
GOOGLE_CLIENT_SECRET=<google_oauth_client_secret>
FACEBOOK_APP_ID=<facebook_app_id>
FACEBOOK_APP_SECRET=<facebook_app_secret>
